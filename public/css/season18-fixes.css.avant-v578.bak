/* ========================================================================== */
/* MHUR Nexus — Saison 18 v23 : section Costumes à venir                    */
/* ========================================================================== */
.s18UpcomingCostumeGroupV23{
  margin:0 0 26px!important;
  padding:14px!important;
  border:4px solid #000!important;
  border-radius:18px!important;
  background:linear-gradient(135deg,#14233a,#08111f)!important;
  box-shadow:0 7px 0 #02050a!important;
}
.s18UpcomingCostumeTitleV23{
  margin:0 0 14px!important;
  padding:12px 16px!important;
  border-left:8px solid #ffe000!important;
  background:#0c1a2d!important;
  color:#fff!important;
  font-size:clamp(25px,3vw,36px)!important;
  font-weight:1000!important;
  text-shadow:2px 2px 0 #000!important;
}
.s18UpcomingCostumeFamiliesV23{
  display:grid!important;
  gap:18px!important;
}
.s18UpcomingCostumeFamilyV23{
  margin:0!important;
}
.s18UpcomingCostumeGridV23{
  display:grid!important;
  grid-template-columns:repeat(auto-fit,minmax(175px,220px))!important;
  gap:14px!important;
  justify-content:start!important;
  overflow:visible!important;
}
.s18UpcomingCostumeGridV23 .costumeTile,
.s18UpcomingCostumeGridV23 .costumeCard{
  width:100%!important;
  max-width:220px!important;
  flex:none!important;
}
@media(max-width:760px){
  .s18UpcomingCostumeGroupV23{padding:10px!important}
  .s18UpcomingCostumeTitleV23{font-size:25px!important}
  .s18UpcomingCostumeGridV23{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:10px!important}
  .s18UpcomingCostumeGridV23 .costumeTile,
  .s18UpcomingCostumeGridV23 .costumeCard{max-width:none!important}
}

/* ========================================================================== */
