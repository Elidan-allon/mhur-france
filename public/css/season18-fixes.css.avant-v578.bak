/* ========================================================================== */
/* MHUR Nexus — Saison 18 v17 : styles/costumes + patch notes mobile         */
/* ========================================================================== */
:root{--s18-header-offset:0px}

/* Patch Notes / Dev Notes : position dynamique sous le header sur téléphone. */
.s18NotesOverlayV10{
  align-items:flex-start!important;
  padding:calc(var(--s18-header-offset,0px) + 10px) 10px 10px!important;
}
.s18NotesPanelV10{
  width:min(1220px,98vw)!important;
  max-height:calc(100dvh - var(--s18-header-offset,0px) - 20px)!important;
}
.s18NotesBodyV10{
  height:min(74vh,780px)!important;
  max-height:calc(100dvh - var(--s18-header-offset,0px) - 170px)!important;
}
.s18NotesPanelV10>header,
.s18NotesPanelV10>nav{
  position:sticky!important;
  top:0!important;
