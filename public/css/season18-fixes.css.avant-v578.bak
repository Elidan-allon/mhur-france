}

/* ========================================================================== */
/* MHUR Nexus — Saison 18 v15 : finitions demandées par l'utilisateur        */
/* ========================================================================== */
#mhurPatchDevButtonV14,.mhurPatchDevButtonV14{
  flex:0 0 auto!important;
  max-width:min(420px,35vw)!important;
}

/* Sorties prévues : cartes plus grandes et art moins vide. */
.s18PlannedGridV14{gap:22px!important}
.s18PlannedCardV14{min-height:308px!important}
.s18PlannedCardV14.wide{min-height:330px!important}
.s18PlannedCardV14 .s18PlannedTextV12{left:18px!important;bottom:18px!important}
.s18PlannedCardV14.wide .s18PlannedTextV12{right:52%!important}
.s18PlannedArtV14 img{object-position:center top!important}
.s18PlannedTsuyuV14{
  display:flex!important;
  align-items:flex-end!important;
  justify-content:flex-end!important;
  padding-right:10px!important;
  background:transparent!important;
}
.s18PlannedTsuyuV14 img{
  width:68%!important;
  height:152%!important;
  max-width:none!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  filter:drop-shadow(0 10px 16px rgba(0,0,0,.45))!important;
}

/* Cartes personnages : réduire le vide en agrandissant davantage le portrait. */
.card[data-char].s18V14CharacterCard .thumb,
.card[data-char].s18V13CharacterCard .thumb,
.card[data-char].s18V12CharacterCard .thumb{
  height:438px!important;
  min-height:438px!important;
}
