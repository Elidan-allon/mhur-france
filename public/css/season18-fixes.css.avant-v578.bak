/* MHUR Nexus — Saison 18 v9 : correctifs ciblés */

/* NEW fourni par l'utilisateur. */
.s18NewBadgeV9,
.s18NewBadge{
  position:absolute!important;
  top:6px!important;
  left:6px!important;
  z-index:30!important;
  width:88px!important;
  height:44px!important;
  min-width:0!important;
  padding:0!important;
  border:0!important;
  border-radius:0!important;
  background:transparent url('../assets/home/icons/new_badge_custom.png') center/contain no-repeat!important;
  color:transparent!important;
  text-indent:-9999px!important;
  overflow:hidden!important;
  box-shadow:none!important;
  transform-origin:top left!important;
  animation:s18NewPulseV9 1.15s ease-in-out infinite!important;
}
@keyframes s18NewPulseV9{0%,100%{transform:scale(.96)}50%{transform:scale(1.08)}}
.costumeTile .s18NewBadge,.costumeResult .s18NewBadge{width:64px!important;height:34px!important;top:4px!important;left:4px!important}

/* Dernières sorties : la bannière officielle remplit immédiatement toute la carte. */
.releaseBannerCardV9{
  position:relative!important;
  min-height:172px!important;
  overflow:hidden!important;
  border:4px solid #05070b!important;
  border-radius:16px!important;
  background:#080b12!important;
  box-shadow:0 7px 0 #050506!important;
}
.releaseBannerCardV9 .releaseBannerImageV9,
.releaseBannerCardV9 .releaseBannerImgV9,
.releaseBannerCardV9 .releaseBannerImageV9 img{
  position:absolute!important;
  inset:0!important;
  display:block!important;
  width:100%!important;
  height:100%!important;
}
.releaseBannerCardV9 .releaseBannerImageV9 img,
.releaseBannerCardV9 .releaseBannerImgV9{
  object-fit:cover!important;
  object-position:center center!important;
  transform:scale(1.015)!important;
}
.releaseBannerShadeV9{
  position:absolute;
  inset:0;
  z-index:2;
  background:linear-gradient(180deg,rgba(0,0,0,.02) 0%,rgba(0,0,0,.08) 52%,rgba(0,0,0,.68) 100%);
}
.releaseBannerCardV9 .releaseBadgeV299{
  z-index:6!important;
  top:10px!important;
  left:10px!important;
  width:36px!important;
  height:36px!important;
}
.releaseNewBadgeV9{
  position:absolute;
  top:7px;
  right:8px;
  z-index:7;
  width:88px;
  height:44px;
  background:url('../assets/home/icons/new_badge_custom.png') center/contain no-repeat;
  filter:drop-shadow(0 3px 0 rgba(0,0,0,.65));
}
.releaseBannerCardV9 .releaseNamesV299{
  position:absolute!important;
  z-index:8!important;
  left:14px!important;
  right:14px!important;
  bottom:11px!important;
  text-align:left!important;
}
.releaseBannerCardV9 .releaseNamesV299 b{
  display:block!important;
  color:#fff!important;
  font-size:clamp(18px,1.8vw,28px)!important;
  line-height:1!important;
  text-shadow:0 3px 0 #000!important;
}
.releaseBannerCardV9 .releaseNamesV299 small{
  display:block!important;
  margin-top:4px!important;
  color:#ffe900!important;
  font-size:clamp(11px,1vw,15px)!important;
  font-weight:900!important;
  text-shadow:0 2px 0 #000!important;
}

/* Cartes personnages : portraits plus grands et réellement centrés. */
.s18CharacterCardV9 .thumb{
  position:relative!important;
  overflow:hidden!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  padding:0!important;
}
.s18CharacterCardV9 .thumb img,
.s18PortraitImgV9{
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center center!important;
  padding:0!important;
  transform:scale(1.28)!important;
  transform-origin:center 56%!important;
  filter:drop-shadow(0 8px 16px rgba(0,0,0,.38))!important;
}
.s18CharacterCardV9 .cardBody{position:relative!important;z-index:4!important}

/* Choix des styles : portrait officiel, grand, centré et sans anciens décalages. */
.s18StyleCardV9{
  position:relative!important;
  overflow:hidden!important;
  border-radius:22px!important;
}
.s18StyleCardV9 .styleBanner{
  position:relative!important;
  overflow:hidden!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  padding:0!important;
}
.s18StyleCardV9 .styleBanner img,
.s18StylePortraitV9,
.styleCard[data-style="assault"] .styleBanner img,
.styleCard[data-style="fullbullet"] .styleBanner img{
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center center!important;
  padding:0!important;
  transform:scale(1.20)!important;
  transform-origin:center 55%!important;
  filter:drop-shadow(0 8px 16px rgba(0,0,0,.38))!important;
}
.s18StyleCardV9.role-technical .styleBanner{background:radial-gradient(circle at 50% 30%,#b14dde 0%,#7513a4 48%,#35094f 100%)!important}
.s18StyleCardV9.role-attack .styleBanner{background:radial-gradient(circle at 50% 30%,#ff5f70 0%,#cd1933 48%,#690a18 100%)!important}
.s18StyleCardV9.role-assault .styleBanner{background:radial-gradient(circle at 50% 30%,#fff06b 0%,#d6b800 48%,#756100 100%)!important}
.s18StyleCardV9.role-support .styleBanner{background:radial-gradient(circle at 50% 30%,#72ff91 0%,#16bf47 48%,#096026 100%)!important}
.s18StyleCardV9.role-rapid .styleBanner{background:radial-gradient(circle at 50% 30%,#70eaff 0%,#18badb 48%,#07566d 100%)!important}
.s18StyleCardV9 .styleInfo h2{font-weight:1000!important;text-shadow:0 3px 0 #000!important}

/* Fiche personnage : photo et typographie propres. */
.s18CharacterDetailV9 .portrait{
  padding:0!important;
  overflow:hidden!important;
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
}
.s18CharacterDetailV9 .portrait img,
.s18DetailPortraitV9{
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center center!important;
  padding:0!important;
  transform:scale(1.08)!important;
  transform-origin:center center!important;
}
.s18CharacterDetailV9 .meta h2{letter-spacing:.2px!important}
.s18HpBadgeV9{font-weight:1000!important;letter-spacing:.2px!important}
.s18QuirkTitleV9{padding:2px 18px 0!important;color:#fff!important;text-shadow:0 3px 0 #000!important;font-style:italic!important;text-transform:uppercase!important}

/* Gentle et nouvelles fiches : tableaux lisibles, pleins et sans Down Power. */
.s18CharacterDetailV9 .skillText .toggle{width:100%!important}
.s18CharacterDetailV9 .skillText .simpleTable{width:100%!important;overflow-x:auto!important}
.s18CharacterDetailV9 .skillText .dataTable{width:100%!important;min-width:max-content!important}
.s18CharacterDetailV9 .skillText .dataTable th,
.s18CharacterDetailV9 .skillText .dataTable td{white-space:nowrap!important;text-align:center!important}
.s18CharacterDetailV9 .skillText .dataTable th:first-child,
.s18CharacterDetailV9 .skillText .dataTable td:first-child{text-align:center!important}

@media(max-width:900px){
  .releaseBannerCardV9{min-height:148px!important}
  .releaseNewBadgeV9{width:70px;height:35px}
  .s18CharacterCardV9 .thumb img,.s18PortraitImgV9{transform:scale(1.20)!important}
  .s18StyleCardV9 .styleBanner img,.s18StylePortraitV9{transform:scale(1.12)!important}
}
/* ========================================================================== */
/* MHUR Nexus — Saison 18 v10                                                */
/* ========================================================================== */

/* NEW n'est plus affiché sur les cartes normales des personnages. */
.card[data-char] > .s18NewBadge,
.s18CharacterCardV10 > .s18NewBadge{display:none!important}

/* Cartes personnages : fond de rôle(s), portrait grand, centré et posé en bas. */
.s18CharacterCardV10 .thumb{
  background:var(--s18-card-bg,radial-gradient(circle at 50% 28%,#b14dde 0%,#7513a4 52%,#35094f 100%))!important;
  min-height:360px!important;
  align-items:flex-end!important;
}
.s18CharacterCardV10 .thumb img,
.s18PortraitImgV10{
  width:100%!important;
  height:100%!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:scale(1.38)!important;
  transform-origin:center bottom!important;
  margin:0!important;
  padding:0!important;
}
.s18CharacterCardV10 .cardBody{background:#071526!important}

/* Styles : fond par rôle visible sur tous les formats et portrait officiel en bas. */
.s18StyleCardV10 .styleBanner{min-height:480px!important;align-items:flex-end!important}
.s18StyleCardV10 .styleBanner img,.s18StylePortraitV10{
  object-position:center bottom!important;
  transform:scale(1.28)!important;
  transform-origin:center bottom!important;
}
.s18CharacterDetailV10 .portrait{align-items:flex-end!important}
.s18CharacterDetailV10 .portrait img,.s18DetailPortraitV10{
  object-position:center bottom!important;
  transform:scale(1.22)!important;
  transform-origin:center bottom!important;
}

/* Bouton Patch / Dev Notes dans le header, Modération retirée du header. */
#mhurAdminButton{display:none!important}
.mhurPatchDevButtonV10{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:7px!important;
  min-height:44px!important;
  padding:0 13px!important;
  border:3px solid #000!important;
  border-radius:12px!important;
  background:linear-gradient(135deg,#ff8a00,#ffe000)!important;
  color:#07101d!important;
  font-weight:1000!important;
  white-space:nowrap!important;
  box-shadow:0 3px 0 #000!important;
}
.mhurPatchDevButtonV10:hover{transform:translateY(-1px)}

/* Sorties prévues de la Saison 18. */
.s18SeasonReleaseV10{
  position:relative!important;
  min-height:200px!important;
  overflow:hidden!important;
  border:4px solid #05070b!important;
  border-radius:16px!important;
  background:#05070b!important;
  box-shadow:0 7px 0 #050506!important;
}
.s18SeasonArtV10,.s18SeasonBlackV10{position:absolute;inset:0;z-index:1;display:block;overflow:hidden}
.s18SeasonArtV10{background-size:cover;background-repeat:no-repeat;background-position:center 35%;transform:scale(1.04)}
.s18SeasonBlackV10{display:flex;align-items:flex-end;justify-content:center;background:#000}
.s18SeasonProfileV10{width:100%;height:112%;object-fit:contain;object-position:center bottom;transform:scale(1.18);transform-origin:center bottom}
.s18SeasonShadeV10{position:absolute;inset:0;z-index:2;background:linear-gradient(180deg,rgba(0,0,0,.03),rgba(0,0,0,.12) 55%,rgba(0,0,0,.82))}
.s18SeasonReleaseV10 .releaseBadgeV299{z-index:6!important;left:10px!important;top:10px!important;width:36px!important;height:36px!important}
.s18SeasonNewV10{position:absolute;z-index:7;right:8px;top:7px;width:88px;height:44px;background:url('../assets/home/icons/new_badge_custom.png') center/contain no-repeat;filter:drop-shadow(0 3px 0 #0009)}
.s18SeasonReleaseV10 .releaseNamesV299{z-index:8!important;left:14px!important;right:14px!important;bottom:10px!important;text-align:left!important}
.s18SeasonReleaseV10 .releaseNamesV299 b{display:block!important;color:#fff!important;font-size:clamp(21px,2vw,31px)!important;line-height:1!important;text-shadow:0 3px 0 #000!important}
.s18SeasonReleaseV10 .releaseNamesV299 small{display:block!important;margin-top:4px!important;color:#ffe900!important;font-size:clamp(12px,1.05vw,16px)!important;font-weight:1000!important;text-shadow:0 2px 0 #000!important}
.s18SeasonReleaseV10 .releaseNamesV299 em{display:block;margin-top:3px;color:#fff;font-size:12px;font-style:normal;font-weight:800;text-shadow:0 2px 0 #000}

/* Fenêtre Patch Notes / Dev Notes. */
.s18NotesOverlayV10,.s18AdminOverlayV10{position:fixed;inset:0;z-index:30000;display:none;align-items:center;justify-content:center;padding:18px;background:rgba(0,0,0,.88);backdrop-filter:blur(6px)}
.s18NotesOverlayV10.open,.s18AdminOverlayV10.open{display:flex}
.s18NotesPanelV10,.s18AdminPanelV10{width:min(1220px,98vw);max-height:95vh;overflow:hidden;border:4px solid #3f648e;border-radius:20px;background:#081323;color:#fff;box-shadow:0 25px 90px #000}
.s18NotesPanelV10>header,.s18AdminPanelV10>header{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 22px;border-bottom:3px solid #000;background:linear-gradient(100deg,#173b65,#1f5a8f)}
.s18NotesPanelV10>header span,.s18AdminPanelV10>header span{color:#ffe000;font-weight:1000}
.s18NotesPanelV10>header h2,.s18AdminPanelV10>header h2{margin:3px 0 0;font-size:clamp(25px,3vw,40px)}
.s18NotesPanelV10>header button,.s18AdminPanelV10>header button{width:48px;height:48px;border:4px solid #000;border-radius:50%;background:#ed5055;color:#fff;font-size:28px;font-weight:1000}
.s18NotesPanelV10>nav,.s18AdminPanelV10>nav{display:flex;gap:8px;padding:10px 14px;border-bottom:2px solid #314f76;background:#0b192b;overflow:auto}
.s18NotesPanelV10>nav button,.s18AdminPanelV10>nav button{padding:10px 16px;border:2px solid #365b87;border-radius:10px;background:#101f34;color:#fff;font-weight:1000;white-space:nowrap}
.s18NotesPanelV10>nav button.active,.s18AdminPanelV10>nav button.active{background:#ffe000;color:#000;border-color:#000}
.s18NotesBodyV10{display:grid;grid-template-columns:300px minmax(0,1fr);height:min(74vh,780px)}
.s18NotesBodyV10>aside{padding:12px;border-right:2px solid #2d496e;overflow:auto;background:#07101d}
.s18NotesBodyV10>aside>button{display:grid;gap:4px;width:100%;margin-bottom:8px;padding:12px;border:2px solid #2e4a70;border-radius:11px;background:#0d1b2e;color:#fff;text-align:left}
.s18NotesBodyV10>aside>button.active{border-color:#ffe000;background:#172944}
.s18NotesBodyV10>aside small{color:#9db1cf}
.s18NotesBodyV10>main{padding:18px;overflow:auto}
.s18PatchDetailHeadV10{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:16px}
.s18PatchDetailHeadV10 h2{margin:0;font-size:clamp(24px,3vw,38px)}
.s18PatchDetailHeadV10>div{display:flex;gap:6px;flex-wrap:wrap}
.s18PatchDetailHeadV10 span,.s18ToneV10{padding:6px 10px;border:2px solid #000;border-radius:999px;color:#fff;font-size:12px;font-weight:1000}
.s18PatchDetailHeadV10 .buff,.s18ToneV10.buff{background:#148a45}
.s18PatchDetailHeadV10 .nerf,.s18ToneV10.nerf{background:#b91e38}
.s18PatchDetailHeadV10 .adjust,.s18ToneV10.adjust{background:#9d7911}
.s18PatchSectionV10{margin:0 0 24px}
.s18PatchSectionV10>h3{margin:0 0 12px;padding:10px 14px;border-left:7px solid #ff8a00;background:#101e31}
.s18PatchSeparatedV10{display:grid;gap:18px}
.s18PatchCharacterV10{overflow:hidden;border:3px solid #304f79;border-radius:17px;background:#0a1627;box-shadow:0 6px 0 #03070d}
.s18PatchCharacterV10>header{display:flex;align-items:center;gap:14px;padding:13px;border-bottom:3px solid #000;background:#15243a}
.s18PatchPortraitV10{width:92px;height:92px;overflow:hidden;border:3px solid #000;border-radius:13px;background:#050b14}
.s18PatchPortraitV10 img{width:100%;height:100%;object-fit:contain;object-position:center bottom}
.s18PatchCharacterV10 h4{margin:0;font-size:24px}
.s18PatchCharacterV10 header strong{display:block;margin:3px 0 8px;color:#ffe000}
.s18PatchBadgesV10{display:flex;gap:7px;flex-wrap:wrap}
.s18PatchChangesV10{display:grid;gap:12px;padding:14px}
.s18PatchChangeV10{position:relative;padding:42px 13px 13px;border:2px solid #314c70;border-radius:13px;background:#0e1b2c}
.s18PatchChangeV10.buff{border-color:#25c86d}.s18PatchChangeV10.nerf{border-color:#e4485d}.s18PatchChangeV10.adjust{border-color:#d1a92a}
.s18ToneV10{position:absolute;top:8px;right:9px}
.s18PatchSkillV10{display:grid;grid-template-columns:88px 1fr;gap:13px;align-items:start}
.s18PatchSkillV10>div{width:88px;height:88px;overflow:hidden;border:2px solid #3d5f8d;border-radius:12px;background:#050a12}
.s18PatchSkillV10>div img{width:100%;height:100%;object-fit:cover}
.s18PatchSkillV10 h5{margin:0 0 7px;font-size:21px}
.s18PatchLabelV10{margin:0 0 9px;color:#8fcfff;font-weight:900}
.s18PatchTableWrapV10{overflow:auto;margin-top:9px}
.s18PatchTableV10{width:100%;min-width:max-content;border-collapse:collapse;background:#091323}
.s18PatchTableV10 th,.s18PatchTableV10 td{padding:8px 10px;border:1px solid #2e4a70;text-align:center;white-space:nowrap}
.s18PatchTableV10 thead th{background:#172945}.s18PatchTableV10 .before th,.s18PatchTableV10 .before td{background:#3c171d}.s18PatchTableV10 .after th,.s18PatchTableV10 .after td{background:#153822}.s18PatchTableV10 .after.adjust th,.s18PatchTableV10 .after.adjust td{background:#3b300f}
.s18DevSideV10{display:grid;gap:6px;padding:18px;border:2px solid #62418e;border-radius:13px;background:#241336}.s18DevSideV10 small{color:#d7c0f5}
.s18DevArticleV10{display:grid;gap:14px}.s18DevHeroV10{padding:20px;border:3px solid #7d33b5;border-radius:16px;background:linear-gradient(135deg,#2f0d50,#641296)}.s18DevHeroV10 span{color:#ffe000;font-weight:1000}.s18DevHeroV10 h2{margin:5px 0;font-size:clamp(26px,4vw,45px)}
.s18DevArticleV10 section{padding:16px;border:2px solid #304f78;border-radius:14px;background:#0d1b2d}.s18DevArticleV10 section h3{margin:0 0 7px;color:#ffe000}.s18DevArticleV10 section p{margin:0;color:#d6e2f4;line-height:1.55}
.s18OfficialLinksV10{display:flex;gap:10px;flex-wrap:wrap}.s18OfficialLinksV10 a{padding:11px 14px;border:3px solid #000;border-radius:10px;background:#19c9de;color:#00131a;font-weight:1000;text-decoration:none}

/* Admin depuis le profil. */
.s18ProfileAdminButtonV10{width:100%;padding:14px;border:4px solid #000;border-radius:13px;background:linear-gradient(135deg,#21cf72,#0fa64f);color:#06110a;font-size:18px;font-weight:1000;box-shadow:0 5px 0 #000}
.s18AdminPanelV10>main{height:min(68vh,720px);padding:18px;overflow:auto}
.s18AdminTitleV10{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:15px}.s18AdminTitleV10 h3{margin:0;font-size:28px}.s18AdminTitleV10 p{margin:5px 0;color:#b9c9df}.s18AdminTitleV10 button{padding:9px 13px;border:3px solid #000;border-radius:9px;background:#19c9de;font-weight:1000}
.s18DeletionListV10{display:grid;gap:12px}.s18DeletionListV10 article{display:grid;grid-template-columns:minmax(220px,1fr) auto auto;align-items:center;gap:14px;padding:14px;border:2px solid #36577f;border-radius:14px;background:#0c192b}.s18DeletionUserV10{display:flex;align-items:center;gap:11px}.s18DeletionUserV10>img,.s18DeletionUserV10>span{width:48px;height:48px;border-radius:50%;object-fit:cover;background:#203958;display:grid;place-items:center}.s18DeletionUserV10 small{display:block;color:#91a7c5;word-break:break-all}.s18DeletionListV10 strong{display:block;text-transform:uppercase}.s18DeletionListV10 .status-pending{color:#ffe000}.s18DeletionListV10 .status-processed{color:#45e886}.s18DeletionListV10 .status-rejected{color:#ff7480}.s18DeletionActionsV10{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}.s18DeletionActionsV10 button{padding:8px 10px;border:2px solid #000;border-radius:8px;background:#e34d57;color:#fff;font-weight:900}.s18DeletionActionsV10 button:first-child{background:#274466}.s18DeletionActionsV10 button.success{background:#20c96a;color:#00150a}
.s18AdminLauncherV10{display:grid;justify-items:center;gap:10px;padding:45px;text-align:center}.s18AdminLauncherV10>span{font-size:62px}.s18AdminLauncherV10 h3{margin:0;font-size:30px}.s18AdminLauncherV10 p{max-width:620px;color:#bdcce1}.s18AdminLauncherV10 button{padding:12px 18px;border:3px solid #000;border-radius:10px;background:#ffe000;font-weight:1000}.s18AdminLoadingV10,.s18AdminEmptyV10,.s18AdminErrorV10{padding:35px;text-align:center;border:2px dashed #43658f;border-radius:14px}.s18AdminErrorV10{color:#ff8991;border-color:#d34b59}

/* Mods : chevron clair et arrivée en haut de page. */
.modsTutorial summary{display:flex!important;align-items:center!important;gap:12px!important;list-style:none!important}
.modsTutorial summary::-webkit-details-marker{display:none!important}
.modsTutorial summary::after{content:'⌄'!important;display:grid!important;place-items:center!important;width:40px!important;height:40px!important;margin-left:auto!important;flex:0 0 40px!important;border:3px solid #000!important;border-radius:50%!important;background:#07111f!important;color:#ffe000!important;font-size:28px!important;font-weight:1000!important;line-height:1!important;transition:transform .2s ease!important}
.modsTutorial[open] summary::after{content:'⌄'!important;transform:rotate(180deg)!important}
.s18ModsHintV10{margin-left:auto;font-size:14px;font-weight:1000;opacity:.8}.modsTutorial summary::after{margin-left:0!important}

@media(max-width:900px){
  .s18CharacterCardV10 .thumb{min-height:290px!important}
  .s18CharacterCardV10 .thumb img,.s18PortraitImgV10{transform:scale(1.30)!important}
  .s18StyleCardV10 .styleBanner{min-height:370px!important}
  .s18StyleCardV10 .styleBanner img,.s18StylePortraitV10{transform:scale(1.20)!important}
  .s18NotesBodyV10{grid-template-columns:1fr;height:min(78vh,780px)}
  .s18NotesBodyV10>aside{display:flex;gap:8px;border-right:0;border-bottom:2px solid #2d496e;overflow:auto}.s18NotesBodyV10>aside>button{min-width:230px;margin:0}
  .s18DeletionListV10 article{grid-template-columns:1fr}.s18DeletionActionsV10{justify-content:flex-start}
  .mhurPatchDevButtonV10 span{display:none}.mhurPatchDevButtonV10{min-width:44px!important;padding:0 10px!important}
}
@media(max-width:600px){
  .s18CharacterCardV10 .thumb{min-height:250px!important}
  .s18CharacterCardV10 .thumb img,.s18PortraitImgV10{transform:scale(1.24)!important}
  .s18StyleCardV10 .styleBanner{min-height:320px!important}
  .s18SeasonReleaseV10{min-height:160px!important}
  .s18SeasonNewV10{width:70px;height:35px}.s18SeasonReleaseV10 .releaseNamesV299 b{font-size:20px!important}
  .s18NotesOverlayV10,.s18AdminOverlayV10{padding:5px}.s18NotesPanelV10,.s18AdminPanelV10{max-height:98vh;border-radius:12px}.s18NotesBodyV10{height:82vh}.s18PatchSkillV10{grid-template-columns:1fr}.s18PatchSkillV10>div{width:72px;height:72px}
  .s18ModsHintV10{display:none}
}
/* Évite d'afficher les anciennes cartes rouges avant le remplacement v10. */
.releaseGridV296:not([data-s18-season-v10]){visibility:hidden!important;min-height:200px!important}

/* ========================================================================== */
/* MHUR Nexus — Saison 18 v11 : fenêtre notes et portraits                   */
/* ========================================================================== */
body.s18NotesOpenV11{overflow:hidden!important}
.s18NotesOverlayV10{
  align-items:flex-start!important;
  justify-content:center!important;
  padding:88px 18px 16px!important;
  overflow:hidden!important;
}
.s18NotesPanelV10{
  width:min(1220px,calc(100vw - 36px))!important;
  height:calc(100dvh - 104px)!important;
  max-height:calc(100dvh - 104px)!important;
  margin:0 auto!important;
  outline:none!important;
}
.s18NotesBodyV10{
  height:calc(100dvh - 252px)!important;
  min-height:0!important;
}
.s18NotesBodyV10>aside,
.s18NotesBodyV10>main{overscroll-behavior:contain!important;scroll-behavior:auto!important}

/* Les portraits commencent bien au bas de la carte et occupent plus d'espace. */
.s18CharacterCardV10 .thumb{
  position:relative!important;
  height:430px!important;
  min-height:430px!important;
  overflow:hidden!important;
  align-items:flex-end!important;
  justify-content:center!important;
}
.s18CharacterCardV10 .thumb img,
.s18PortraitImgV10{
  position:absolute!important;
  left:50%!important;
  bottom:0!important;
  width:116%!important;
  height:116%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:translateX(-50%) scale(1.10)!important;
  transform-origin:center bottom!important;
  margin:0!important;
  padding:0!important;
}
.s18StyleCardV10 .styleBanner{
  position:relative!important;
  height:520px!important;
  min-height:520px!important;
  overflow:hidden!important;
  align-items:flex-end!important;
  justify-content:center!important;
}
.s18StyleCardV10 .styleBanner img,
.s18StylePortraitV10{
  position:absolute!important;
  left:50%!important;
  bottom:0!important;
  width:118%!important;
  height:118%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:translateX(-50%) scale(1.08)!important;
  transform-origin:center bottom!important;
  margin:0!important;
  padding:0!important;
}
/* Fonds nets par rôle : plus de halo flou dans la partie haute. */
.s18StyleCardV10.role-technical .styleBanner{background:linear-gradient(180deg,#a532d4 0%,#7411a4 55%,#42075f 100%)!important}
.s18StyleCardV10.role-attack .styleBanner{background:linear-gradient(180deg,#ef354d 0%,#bd102a 55%,#680716 100%)!important}
.s18StyleCardV10.role-assault .styleBanner{background:linear-gradient(180deg,#ffe547 0%,#cba800 55%,#756000 100%)!important}
.s18StyleCardV10.role-support .styleBanner{background:linear-gradient(180deg,#54e978 0%,#13a842 55%,#075a25 100%)!important}
.s18StyleCardV10.role-rapid .styleBanner{background:linear-gradient(180deg,#48daf1 0%,#12a8ca 55%,#07566e 100%)!important}

/* Image officielle dédiée à Full Bullet. */
.s18StyleCardV10[data-style="fullbullet"] .styleBanner img,
.s18StyleCardV10[data-style*="midoriya_attack"] .styleBanner img{
  width:128%!important;
  height:112%!important;
  transform:translateX(-50%) scale(1.16)!important;
  filter:drop-shadow(0 12px 14px rgba(0,0,0,.45))!important;
}
/* Gentle : image officielle propre, sans étirement ni zone floue en haut. */
.s18StyleCardV10[data-style*="gentle"] .styleBanner img{
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
  object-position:center top!important;
  transform:translateX(-50%)!important;
  filter:none!important;
}

@media(max-width:900px){
  .s18NotesOverlayV10{padding:82px 8px 8px!important}
  .s18NotesPanelV10{width:calc(100vw - 16px)!important;height:calc(100dvh - 90px)!important;max-height:calc(100dvh - 90px)!important}
  .s18NotesBodyV10{height:calc(100dvh - 240px)!important}
  .s18CharacterCardV10 .thumb{height:350px!important;min-height:350px!important}
  .s18CharacterCardV10 .thumb img,.s18PortraitImgV10{width:120%!important;height:120%!important;transform:translateX(-50%) scale(1.08)!important}
  .s18StyleCardV10 .styleBanner{height:420px!important;min-height:420px!important}
  .s18StyleCardV10 .styleBanner img,.s18StylePortraitV10{width:122%!important;height:122%!important;transform:translateX(-50%) scale(1.06)!important}
  .s18StyleCardV10[data-style*="gentle"] .styleBanner img{width:100%!important;height:100%!important;transform:translateX(-50%)!important}
}
@media(max-width:600px){
  .s18NotesOverlayV10{padding:72px 4px 4px!important}
  .s18NotesPanelV10{width:calc(100vw - 8px)!important;height:calc(100dvh - 76px)!important;max-height:calc(100dvh - 76px)!important;border-radius:10px!important}
  .s18NotesBodyV10{height:calc(100dvh - 224px)!important}
  .s18NotesPanelV10>header{padding:10px 12px!important}
  .s18NotesPanelV10>header h2{font-size:22px!important}
  .s18NotesPanelV10>nav button{padding:8px 11px!important}
  .s18CharacterCardV10 .thumb{height:300px!important;min-height:300px!important}
  .s18StyleCardV10 .styleBanner{height:360px!important;min-height:360px!important}
}

/* ========================================================================== */
/* MHUR Nexus — Saison 18 v12 : premier affichage, sorties et portraits      */
/* ========================================================================== */
#mhurAdminButton,
header.top #mhurAdminButton,
header.top .mhurAdminTopButton,
header.top [data-mhur-admin]{display:none!important;visibility:hidden!important;pointer-events:none!important}

.mhurPatchDevButtonV12,
#mhurPatchDevButtonV12{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:8px!important;
  min-height:48px!important;
  padding:7px 14px!important;
  border:2px solid #49658d!important;
  border-radius:14px!important;
  background:#132139!important;
  color:#fff!important;
  font-weight:1000!important;
  white-space:nowrap!important;
  cursor:pointer!important;
}
.mhurPatchDevButtonV12:hover{border-color:#ffe100!important}
.mhurPatchDevIconV12{font-size:17px;line-height:1}

/* L'ancienne règle de masquage ne doit plus laisser une grande zone vide. */
.releaseGridV296,
.releaseGridV296:not([data-s18-season-v10]){
  visibility:visible!important;
  min-height:0!important;
}
.s18PlannedGridV12{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:16px!important;
  align-items:stretch!important;
}
.s18PlannedCardV12{
  position:relative!important;
  display:block!important;
  width:100%!important;
  min-height:210px!important;
  margin:0!important;
  padding:0!important;
  overflow:hidden!important;
  border:4px solid #05070b!important;
  border-radius:16px!important;
  background:#05070b!important;
  box-shadow:0 7px 0 #050506!important;
  color:#fff!important;
  text-align:left!important;
}
.s18PlannedCardV12.is-clickable{cursor:pointer!important}
.s18PlannedCardV12.is-clickable:hover{border-color:#ffe100!important;transform:translateY(-1px)}
.s18PlannedCardV12.is-disabled{cursor:default!important;user-select:none!important}
.s18PlannedArtV12{position:absolute;inset:0;z-index:1;background-position:center;background-size:cover;background-repeat:no-repeat}
.s18PlannedShadeV12{position:absolute;inset:0;z-index:2;background:linear-gradient(90deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,.16) 48%,rgba(0,0,0,.12) 70%,rgba(0,0,0,.34) 100%),linear-gradient(180deg,transparent 45%,rgba(0,0,0,.78) 100%)}
.s18PlannedTypeV12{position:absolute;z-index:5;left:12px;top:12px;width:38px;height:38px;filter:drop-shadow(0 3px 0 #000)}
.s18PlannedTypeV12 img{width:100%;height:100%;object-fit:contain}
.s18PlannedNewV12{position:absolute;z-index:5;right:12px;top:10px;width:92px;height:46px;background:url('../assets/home/icons/new_badge_custom.png') center/contain no-repeat;filter:drop-shadow(0 3px 0 rgba(0,0,0,.65))}
.s18PlannedTextV12{position:absolute;z-index:6;left:14px;right:14px;bottom:13px;display:block;text-shadow:0 3px 0 #000}
.s18PlannedTextV12 b{display:block;font-size:clamp(25px,2.2vw,35px);line-height:1;font-weight:1000}
.s18PlannedTextV12 small{display:block;margin-top:7px;color:#ffed00;font-size:clamp(14px,1.25vw,18px);font-weight:1000}
.s18PlannedTextV12 em{display:block;margin-top:5px;color:#fff;font-size:13px;font-style:normal;font-weight:850}
.s18PlannedTsuyuV12{position:absolute;inset:0;z-index:1;display:flex;align-items:flex-end;justify-content:center;background:#000}
.s18PlannedTsuyuV12 img{width:auto;height:112%;max-width:95%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 9px 12px rgba(0,0,0,.5))}

/* Tous les portraits des listes de personnages ont un vrai fond de rôle et
   commencent au bas de la carte. Cela couvre aussi les anciens rendus. */
.card[data-char].s18V12CharacterCard .thumb,
.card[data-char].s18CharacterCardV10 .thumb,
.card[data-char].s18CharacterCardV9 .thumb{
  position:relative!important;
  display:flex!important;
  align-items:flex-end!important;
  justify-content:center!important;
  height:420px!important;
  min-height:420px!important;
  padding:0!important;
  overflow:hidden!important;
  background:var(--s18-v12-role-bg,var(--s18-card-bg,#12afd0))!important;
}
.card[data-char].s18V12CharacterCard .thumb img,
.card[data-char].s18CharacterCardV10 .thumb img,
.card[data-char].s18CharacterCardV9 .thumb img{
  position:absolute!important;
  left:50%!important;
  bottom:-1px!important;
  width:128%!important;
  height:128%!important;
  max-width:none!important;
  max-height:none!important;
  margin:0!important;
  padding:0!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:translateX(-50%)!important;
  transform-origin:center bottom!important;
  filter:drop-shadow(0 10px 13px rgba(0,0,0,.42))!important;
}

/* Choix d'un style : fond propre par rôle et photo exacte de la base. */
.styleCard[data-style].s18V12StyleCard .styleBanner,
.styleCard[data-style].s18StyleCardV10 .styleBanner,
.styleCard[data-style].s18StyleCardV9 .styleBanner{
  position:relative!important;
  display:flex!important;
  align-items:flex-end!important;
  justify-content:center!important;
  height:540px!important;
  min-height:540px!important;
  padding:0!important;
  overflow:hidden!important;
}
.styleCard[data-style].s18V12StyleCard .styleBanner img,
.styleCard[data-style].s18StyleCardV10 .styleBanner img,
.styleCard[data-style].s18StyleCardV9 .styleBanner img{
  position:absolute!important;
  left:50%!important;
  bottom:-1px!important;
  width:130%!important;
  height:130%!important;
  max-width:none!important;
  max-height:none!important;
  margin:0!important;
  padding:0!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:translateX(-50%)!important;
  transform-origin:center bottom!important;
  filter:drop-shadow(0 11px 14px rgba(0,0,0,.42))!important;
}
.styleCard[data-style].role-attack .styleBanner{background:radial-gradient(circle at 50% 24%,#ff6576 0%,#dc1d3b 52%,#710817 100%)!important}
.styleCard[data-style].role-assault .styleBanner{background:radial-gradient(circle at 50% 24%,#fff16b 0%,#dfc000 52%,#746000 100%)!important}
.styleCard[data-style].role-technical .styleBanner{background:radial-gradient(circle at 50% 24%,#c15ce8 0%,#8818b8 52%,#430760 100%)!important}
.styleCard[data-style].role-support .styleBanner{background:radial-gradient(circle at 50% 24%,#78ff98 0%,#19bb50 52%,#075c28 100%)!important}
.styleCard[data-style].role-rapid .styleBanner{background:radial-gradient(circle at 50% 24%,#76efff 0%,#18b9d9 52%,#07576d 100%)!important}

/* Fiche détaillée : la photo remplit réellement le cadre coloré. */
.charPanel.s18V12CharacterDetail .charTop .portrait,
.charPanel.s18CharacterDetailV10 .charTop .portrait,
.charPanel.s18CharacterDetailV9 .charTop .portrait{
  position:relative!important;
  display:flex!important;
  align-items:flex-end!important;
  justify-content:center!important;
  min-height:410px!important;
  padding:0!important;
  overflow:hidden!important;
}
.charPanel.s18V12CharacterDetail .charTop .portrait img,
.charPanel.s18CharacterDetailV10 .charTop .portrait img,
.charPanel.s18CharacterDetailV9 .charTop .portrait img{
  position:absolute!important;
  left:50%!important;
  bottom:-1px!important;
  width:132%!important;
  height:132%!important;
  max-width:none!important;
  max-height:none!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  transform:translateX(-50%)!important;
  transform-origin:center bottom!important;
  margin:0!important;
  padding:0!important;
}

@media(max-width:900px){
  .s18PlannedGridV12{grid-template-columns:1fr!important}
  .s18PlannedCardV12{min-height:190px!important}
  .card[data-char].s18V12CharacterCard .thumb,.card[data-char].s18CharacterCardV10 .thumb,.card[data-char].s18CharacterCardV9 .thumb{height:360px!important;min-height:360px!important}
  .styleCard[data-style].s18V12StyleCard .styleBanner,.styleCard[data-style].s18StyleCardV10 .styleBanner,.styleCard[data-style].s18StyleCardV9 .styleBanner{height:450px!important;min-height:450px!important}
  .charPanel.s18V12CharacterDetail .charTop .portrait,.charPanel.s18CharacterDetailV10 .charTop .portrait,.charPanel.s18CharacterDetailV9 .charTop .portrait{min-height:350px!important}
}
@media(max-width:600px){
  .mhurPatchDevButtonV12 span:last-child{display:none!important}
  .mhurPatchDevButtonV12{min-width:44px!important;padding:6px 10px!important}
  .s18PlannedCardV12{min-height:165px!important}
  .s18PlannedNewV12{width:72px;height:36px}
  .s18PlannedTextV12 b{font-size:22px}
  .s18PlannedTextV12 small{font-size:13px}
  .card[data-char].s18V12CharacterCard .thumb,.card[data-char].s18CharacterCardV10 .thumb,.card[data-char].s18CharacterCardV9 .thumb{height:320px!important;min-height:320px!important}
  .styleCard[data-style].s18V12StyleCard .styleBanner,.styleCard[data-style].s18StyleCardV10 .styleBanner,.styleCard[data-style].s18StyleCardV9 .styleBanner{height:390px!important;min-height:390px!important}
}

/* ===== Saison 18 v13 — stabilité du premier rendu ===== */
#mhurPatchDevButtonV13,.mhurPatchDevButtonV13{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:8px!important;
  min-height:48px!important;
  padding:7px 14px!important;
  border:2px solid #49658d!important;
  border-radius:14px!important;
  background:#132139!important;
  color:#fff!important;
  font-weight:1000!important;
  white-space:nowrap!important;
  cursor:pointer!important;
}
#mhurPatchDevButtonV13:hover,.mhurPatchDevButtonV13:hover{border-color:#ffe100!important}
.s18PlannedGridV13{visibility:visible!important;min-height:0!important}
.s18PlannedCardV13{contain:layout paint;isolation:isolate}
.s18PlannedArtV13{will-change:auto!important}
.card[data-char].s18V13CharacterCard .thumb,
.styleCard[data-style].s18V13StyleCard .styleBanner,
.charPanel.s18V13CharacterDetail .charTop .portrait{isolation:isolate}
@media(max-width:600px){
  #mhurPatchDevButtonV13 span:last-child,.mhurPatchDevButtonV13 span:last-child{display:none!important}
  #mhurPatchDevButtonV13,.mhurPatchDevButtonV13{min-width:44px!important;padding:6px 10px!important}
}

/* ========================================================================== */
/* Saison 18 v14 — cartes plus grandes, fonds d'origine et header idempotent */
/* ========================================================================== */
#mhurPatchDevButtonV14,.mhurPatchDevButtonV14{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  gap:8px!important;
  min-height:48px!important;
  max-width:min(360px,31vw)!important;
  padding:7px 14px!important;
  border:2px solid #49658d!important;
  border-radius:14px!important;
  background:#132139!important;
  color:#fff!important;
  font-weight:1000!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  cursor:pointer!important;
}
#mhurPatchDevButtonV14:hover,.mhurPatchDevButtonV14:hover{border-color:#ffe100!important}

.s18PlannedGridV14{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:20px!important;
  padding:0!important;
  margin:0!important;
  background:transparent!important;
}
.s18PlannedCardV14{
  min-height:278px!important;
  background:transparent!important;
  border:4px solid #05070b!important;
  border-radius:17px!important;
  box-shadow:0 8px 0 #050506!important;
}
.s18PlannedCardV14.wide{grid-column:1/-1!important;min-height:285px!important}
.s18PlannedArtV14{position:absolute!important;inset:0!important;display:block!important;overflow:hidden!important;background:none!important}
.s18PlannedArtV14 img{
  display:block!important;
  width:100%!important;
  height:100%!important;
  object-fit:cover!important;
  object-position:center center!important;
  opacity:1!important;
}
.s18PlannedTsuyuV14{background:#000!important}
.s18PlannedTsuyuV14 img{height:128%!important;max-width:100%!important;object-position:center bottom!important}
.s18PlannedCardV14 .s18PlannedShadeV12{background:linear-gradient(90deg,rgba(0,0,0,.68) 0%,rgba(0,0,0,.12) 46%,rgba(0,0,0,.08) 68%,rgba(0,0,0,.38) 100%),linear-gradient(180deg,transparent 42%,rgba(0,0,0,.82) 100%)!important}
.s18PlannedCardV14 .s18PlannedTextV12 b{font-size:clamp(30px,2.5vw,42px)!important}
.s18PlannedCardV14 .s18PlannedTextV12 small{font-size:clamp(16px,1.35vw,20px)!important}
.s18PlannedCardV14 .s18PlannedTextV12 em{font-size:14px!important}

/* Une seule couleur sur la carte personnage : celle du style Original. */
.card[data-char].s18V14CharacterCard .thumb,
.card[data-char].s18V13CharacterCard .thumb,
.card[data-char].s18V12CharacterCard .thumb{
  height:470px!important;
  min-height:470px!important;
  padding:0!important;
}
.card[data-char].s18V14CharacterCard .thumb img,
.card[data-char].s18V13CharacterCard .thumb img,
.card[data-char].s18V12CharacterCard .thumb img{
  width:146%!important;
  height:146%!important;
  max-width:none!important;
  max-height:none!important;
  bottom:-2px!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  opacity:1!important;
}

.styleCard[data-style].s18V14StyleCard .styleBanner,
.styleCard[data-style].s18V13StyleCard .styleBanner,
.styleCard[data-style].s18V12StyleCard .styleBanner{
  height:575px!important;
  min-height:575px!important;
}
.styleCard[data-style].s18V14StyleCard .styleBanner img,
.styleCard[data-style].s18V13StyleCard .styleBanner img,
.styleCard[data-style].s18V12StyleCard .styleBanner img{
  width:145%!important;
  height:145%!important;
  bottom:-2px!important;
  object-fit:contain!important;
  object-position:center bottom!important;
  opacity:1!important;
}

.charPanel.s18V14CharacterDetail .charTop .portrait,
.charPanel.s18V13CharacterDetail .charTop .portrait,
.charPanel.s18V12CharacterDetail .charTop .portrait{min-height:455px!important}
.charPanel.s18V14CharacterDetail .charTop .portrait img,
.charPanel.s18V13CharacterDetail .charTop .portrait img,
.charPanel.s18V12CharacterDetail .charTop .portrait img{
  width:145%!important;
  height:145%!important;
  bottom:-2px!important;
  opacity:1!important;
}

@media(max-width:1100px){
  #mhurPatchDevButtonV14 span:last-child,.mhurPatchDevButtonV14 span:last-child{max-width:210px;overflow:hidden;text-overflow:ellipsis}
  .s18PlannedCardV14{min-height:245px!important}
  .s18PlannedCardV14.wide{min-height:250px!important}
  .card[data-char].s18V14CharacterCard .thumb,.card[data-char].s18V13CharacterCard .thumb,.card[data-char].s18V12CharacterCard .thumb{height:420px!important;min-height:420px!important}
}
@media(max-width:760px){
  .s18PlannedGridV14{grid-template-columns:1fr!important;gap:16px!important}
  .s18PlannedCardV14,.s18PlannedCardV14.wide{grid-column:auto!important;min-height:220px!important}
  .card[data-char].s18V14CharacterCard .thumb,.card[data-char].s18V13CharacterCard .thumb,.card[data-char].s18V12CharacterCard .thumb{height:365px!important;min-height:365px!important}
  .styleCard[data-style].s18V14StyleCard .styleBanner,.styleCard[data-style].s18V13StyleCard .styleBanner,.styleCard[data-style].s18V12StyleCard .styleBanner{height:470px!important;min-height:470px!important}
}
@media(max-width:600px){
  #mhurPatchDevButtonV14,.mhurPatchDevButtonV14{min-width:44px!important;max-width:48px!important;padding:6px 10px!important}
  #mhurPatchDevButtonV14 span:last-child,.mhurPatchDevButtonV14 span:last-child{display:none!important}
  .s18PlannedCardV14,.s18PlannedCardV14.wide{min-height:190px!important}
  .s18PlannedCardV14 .s18PlannedTextV12 b{font-size:24px!important}
  .s18PlannedCardV14 .s18PlannedTextV12 small{font-size:13px!important}
  .card[data-char].s18V14CharacterCard .thumb,.card[data-char].s18V13CharacterCard .thumb,.card[data-char].s18V12CharacterCard .thumb{height:330px!important;min-height:330px!important}
