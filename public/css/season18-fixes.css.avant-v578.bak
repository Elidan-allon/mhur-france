.s18UpcomingCostumeGroupV23 .s18NewBadge{display:none!important}


/* ========================================================================== */
/* MHUR Nexus — Saison 18 v25 : dates upcoming + familles pleine largeur     */
/* ========================================================================== */
.s18UpcomingCostumeIntroV25{
  margin:-4px 0 16px!important;
  padding:10px 14px!important;
  border:2px solid #31527b!important;
  border-radius:10px!important;
  background:#091528!important;
  color:#dceaff!important;
  font-size:15px!important;
  font-weight:800!important;
}
.s18UpcomingCostumeFamilyV23{
  overflow:hidden!important;
  border:3px solid #05070b!important;
  border-radius:13px!important;
  background:#08111f!important;
  box-shadow:0 5px 0 #02050a!important;
}
.s18UpcomingCostumeFamilyV23 .costumeGalleryHead{
  margin:0!important;
  border-radius:0!important;
}
.s18UpcomingCostumeGridV23{
  padding:14px!important;
  background:repeating-linear-gradient(135deg,#0b1728 0 22px,#0d1c31 22px 44px)!important;
}
.s18UpcomingCostumeTileV25{
  position:relative!important;
  border-color:#ffdc00!important;
  box-shadow:0 0 0 3px #ffdc0030,0 5px 0 #02050a!important;
}
.s18UpcomingStatusV25,
.s18UpcomingDateV25{
  position:absolute!important;
  z-index:20!important;
  pointer-events:none!important;
  border:2px solid #000!important;
  box-shadow:0 3px 0 #000!important;
  font-weight:1000!important;
  line-height:1!important;
}
.s18UpcomingStatusV25{
  top:8px!important;
  left:8px!important;
  padding:7px 9px!important;
  border-radius:8px!important;
  background:#ffdc00!important;
  color:#05080e!important;
  font-size:12px!important;
}
.s18UpcomingDateV25{
  right:7px!important;
  bottom:7px!important;
  max-width:calc(100% - 14px)!important;
  padding:7px 9px!important;
  border-radius:8px!important;
  background:#0b1c32!important;
  color:#fff!important;
  font-size:12px!important;
  text-align:center!important;
  white-space:nowrap!important;
}

@media(min-width:901px){
